{
  "name": "chandlery-lite",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "dev:setup": "pnpm run db:migrate:local && pnpm run db:seed:local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "CI=1 wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:seed:local": "CI=1 wrangler d1 execute DB --local --persist-to .wrangler/state --file scripts/seed.sql --yes",
    "admin:grant": "f(){ CI=1 wrangler d1 execute DB --local --persist-to .wrangler/state --command \"UPDATE user SET role='admin' WHERE email=lower('$1')\" --yes; }; f",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config scripts/auth.config.ts --output src/db/auth-schema.ts -y",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:live": "pnpm run db:migrate:remote && pnpm run build && wrangler deploy -c dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth-ui/core": "^1.7.30",
    "@better-auth-ui/react": "^1.7.30",
    "@faker-js/faker": "^10.3.0",
    "@orpc/client": "^1.13.6",
    "@orpc/json-schema": "^1.13.6",
    "@orpc/openapi": "^1.13.6",
    "@orpc/server": "^1.13.6",
    "@orpc/tanstack-query": "^1.13.6",
    "@orpc/zod": "^1.13.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "0.11.2",
    "better-auth": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "kysely": "~0.28.7"
    }
  },
  "packageManager": "pnpm@11.1.2",
  "license": "MIT"
}
