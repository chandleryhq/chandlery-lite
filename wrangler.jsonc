{
	"$schema": "node_modules/wrangler/config-schema.json",
	// ─────────────────────────────────────────────────────────────
	// One environment, on purpose.
	//
	// The paid starter ships three (local / staging / production) with placeholder
	// resource ids that fail loudly until you provision, because a person deploying
	// their own business should not discover at 2am that staging wrote to production.
	// This free skeleton is aimed at the opposite case: somebody clicking "Deploy to
	// Cloudflare" who wants a running app in one step. Cloudflare's deploy flow
	// provisions the D1 database and rewrites `database_id` below, and it cannot do
	// that for an `env.*` block it was not told to pick.
	//
	// So: one environment, one database, `wrangler deploy` with no --env. If you grow
	// into needing separate staging and production, that is the shape the starter has.
	// ─────────────────────────────────────────────────────────────
	"name": "chandlery-lite",
	// Thin wrapper around the TanStack Start server entry so that cron, Durable
	// Objects, Queues and Workflows can be exported from the same Worker.
	"main": "src/server/entry.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// D1 lives in a single region; Smart Placement moves the Worker next to it so a
	// request with several DB round-trips does not pay cross-region latency.
	"placement": { "mode": "smart" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chandlery-lite-db",
			// The Deploy to Cloudflare button replaces this when it provisions the
			// database. Deploying by hand instead? Run `wrangler d1 create chandlery-lite-db`
			// and paste the id it prints here. The TODO- prefix is deliberate: every
			// command that needs a real database fails with a readable error until it
			// is replaced, rather than quietly targeting nothing.
			"database_id": "TODO-YOUR-D1-ID",
			"migrations_dir": "migrations"
		}
	]
}
